{
    "name": "orbit",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "scripts": {
        "bot": "bun --watch apps/bot/src/index.ts",
        "bot:start": "bun apps/bot/src/index.ts",
        "check": "bun run format:check && bun run lint && bun run typecheck",
        "dashboard": "bun --filter @orbit/dashboard dev",
        "dashboard:build": "bun --filter @orbit/dashboard build",
        "dashboard:start": "bun --filter @orbit/dashboard preview",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "sort-package": "sort-package-json package.json apps/*/package.json packages/*/package.json",
        "typecheck": "bun --filter @orbit/bot typecheck && bun --filter @orbit/dashboard check"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/bun": "^1.3.14",
        "eslint": "^10.4.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-simple-import-sort": "^13.0.0",
        "eslint-plugin-svelte": "^3.17.1",
        "globals": "^17.6.0",
        "prettier": "^3.8.3",
        "prettier-plugin-svelte": "^4.0.1",
        "sort-package-json": "^3.6.1",
        "svelte-eslint-parser": "^1.6.1",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.59.4"
    },
    "packageManager": "bun@1.3.1"
}
