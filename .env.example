# Telegram
TELEGRAM_BOT_TOKEN=
# Bot username without @ — used for the account-linking deep link on the profile page
TELEGRAM_BOT_USERNAME=

# OpenAI (required — Whisper transcription always uses this key)
OPENAI_API_KEY=
OPENAI_TRANSCRIBE_MODEL=whisper-1
OPENAI_CHAT_MODEL=gpt-4o-mini

# Optional: when set, claude-* models in OPENAI_CHAT_MODEL or ANTHROPIC_CHAT_MODEL
# go direct to Anthropic API. Get key from https://console.anthropic.com/keys
# Recommended for strategic reasoning (e.g. /strategy page).
ANTHROPIC_API_KEY=
# Optional: when set + ANTHROPIC_API_KEY set, overrides OPENAI_CHAT_MODEL.
# Examples: claude-sonnet-4-6 (best balance), claude-opus-4-7 (top reasoning, expensive),
# claude-haiku-4-5 (cheap+fast).
ANTHROPIC_CHAT_MODEL=

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Public anon key — the dashboard uses it with the user's session so RLS scopes queries per user
SUPABASE_ANON_KEY=
SUPABASE_STORAGE_BUCKET=orbit-audio

# Dashboard
PUBLIC_DASHBOARD_TITLE=Orbit

# Bot HTTP server
BOT_PORT=3001
